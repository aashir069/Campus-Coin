# CampusCoin environment configuration
# Copy this file to ".env" (same folder) and adjust. Every value is optional —
# the defaults below match a fresh XAMPP install (root user, empty password).

APP_ENV=development        # development | production
APP_DEBUG=true             # show detailed errors (set false in production)
APP_TIMEZONE=Asia/Karachi
# APP_BASE_PATH=/CampusCoin   # only needed if auto-detection of the URL path fails

DB_HOST=localhost
DB_PORT=3306
DB_NAME=campuscoin
DB_USER=root
DB_PASS=

# ---- Optional AI integration (the app works fully without it) ----
AI_ENABLED=false
AI_PROVIDER=gemini         # gemini | anthropic | openai  (openai = any OpenAI-compatible API)
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite   # e.g. gemini-3.5-flash-lite, claude-sonnet-5, gpt-4o-mini
# AI_API_URL=              # override for custom endpoints

# ---- Optional CampusCoin AI Assistant chatbot (Google Gemini) ----
GEMINI_API_KEY=            # your Google Gemini API key (or uses AI_API_KEY if configured)
GEMINI_MODEL=gemini-3.5-flash-lite  # e.g. gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.8-flash
