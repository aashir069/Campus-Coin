Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
</IfModule>

# Custom 404 page (adjust the folder name if you rename the project)
ErrorDocument 404 /CampusCoin/404.php

# Never expose environment / SQL files over HTTP
<FilesMatch "^(\.env|.*\.sql|.*\.log|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
